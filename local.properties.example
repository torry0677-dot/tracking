# 이 파일을 local.properties 로 복사한 뒤 값을 채워 주세요. (local.properties 는 git에 올라가지 않습니다)
# sdk.dir=/Users/me/Library/Android/sdk   (Android Studio가 자동으로 채워 줍니다)

# 네이버 클라우드 플랫폼 > Maps > Application 에서 발급받은 Client ID
NAVER_CLIENT_ID=

# 공유 링크가 열릴 웹 페이지 주소 (GitHub Pages). 비워 두면 아래 기본값을 씁니다.
# SHARE_BASE_URL=https://torry0677-dot.github.io/tracking/
